{
  "name": "symplr",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "css": "npm-run-all css-compile css-prefix css-compress",
    "css-compile": "sass src/scss/main.scss public/css/styles.css",
    "css-prefix": "postcss public/css/styles.css --use=autoprefixer --map=false  --output=public/css/styles.css",
    "css-compress": "sass public/css/styles.css public/css/styles.min.css --style compressed",
    "js": "webpack",
    "js-lib": "concat -o public/js/libs.js src/js/libs/fancybox.umd.js",
    "build": "npm-run-all css js js-lib php2html",
    "watch": "watch 'npm run build' src",
    "watch-js": "watch 'npm-run-all js js-lib' src",
    "php2html": "php2html public/index.php > public/index.html"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@foragefox/doubledash": "^1.2.6",
    "bootstrap": "^5.3.1",
    "gsap": "^3.12.5",
    "lottie-web": "^5.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.13.10",
    "@babel/preset-env": "^7.13.10",
    "autoprefixer": "^10.4.12",
    "babel-loader": "^8.2.2",
    "concat": "^1.0.3",
    "dotenv": "^16.0.3",
    "json-loader": "^0.5.7",
    "npm-run-all": "^4.1.5",
    "php2html": "^4.0.0",
    "postcss": "^8.4.17",
    "postcss-cli": "^10.0.0",
    "sass": "^1.53.0",
    "watch": "^0.13.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
